---
import { STAGES, type Stage } from "@/gardens";

type Props = {
  stage: Stage;
  size?: "sm" | "lg";
};

const { stage, size = "sm" } = Astro.props;
const { emoji, label, description } = STAGES[stage];
---

<span
  title={description}
  class:list={[
    "border-border text-muted-foreground inline-flex items-center gap-1 rounded-full border px-2 py-0.5 whitespace-nowrap",
    { "text-xs": size === "sm" },
    { "text-sm": size === "lg" },
  ]}
>
  <span aria-hidden="true">{emoji}</span>
  {label}
</span>
